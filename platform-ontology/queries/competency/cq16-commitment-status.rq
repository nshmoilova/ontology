# CQ-16 — For each committed commitment, its latest observation and whether the
# target is met, judged by the commitment's comparator. Breached rows are the
# 'is it being met' answer; met rows are the evidence.
PREFIX cmt:  <https://w3id.org/examplebank/platform/commitment#>
PREFIX cp:   <https://w3id.org/examplebank/platform/control-plane#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?commitment ?offering ?metric ?comparator ?target ?latest ?windowEnd
       (IF(BOUND(?latest), IF((?c = cmt:at-least && ?latest >= ?target) || (?c = cmt:at-most && ?latest <= ?target), "met", "breached"), "no observation") AS ?status) WHERE {
  ?commitment a cmt:Commitment ; cmt:commitsTo ?offering ; cmt:metric ?m ; cmt:comparator ?c ; cmt:target ?target ;
              cmt:hasCommitmentState cmt:state-committed .
  ?m skos:notation ?metric . ?c skos:notation ?comparator .
  OPTIONAL {
    ?obs cmt:observationOf ?commitment ; sosa:hasSimpleResult ?latest ; cp:windowEnd ?windowEnd .
    FILTER NOT EXISTS { ?o2 cmt:observationOf ?commitment ; cp:windowEnd ?e2 . FILTER(?e2 > ?windowEnd) }
  }
}
ORDER BY ?offering ?commitment
