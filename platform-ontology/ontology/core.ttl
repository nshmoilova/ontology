@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix core:  <https://w3id.org/examplebank/platform/core#> .
@prefix vs:    <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

<https://w3id.org/examplebank/platform/core>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/examplebank/platform/core/0.7.0> ;
    owl:versionInfo "0.7.0" ;
    dct:title "Platform Core Ontology"@en ;
    dct:description "Upper module for the application platform ontology: principals, resources, events, and XACML-style policy architecture roles. All domain modules import this module. Since 0.2.0: tenants (the platform itself being a distinguished tenant), capabilities, tenant-owned applications, and the closed delivery-channel vocabulary — platform-wide primitives promoted from the control-plane module while all terms are draft. Since 0.5.0: the decision point and the enforcement point are disjoint — a decision is rendered by one component and acted on by another (P13). Since 0.6.0: the closed data-category scheme — the kind of data a stored fact or a data plane holds, for residency, sovereignty, retention and minimisation; kind, not sensitivity (D63). Since 0.7.0: jurisdictions (nested), deployment regions mapped to jurisdictions, and legal entities under a jurisdiction that operate workloads and data planes — the three crossings of D64."@en ;
    dct:created "2026-08-31"^^xsd:date ;
    dct:conformsTo <https://www.w3.org/TR/owl2-profiles/#OWL_2_QL> .

#################################################################
# Classes
#################################################################

core:Principal a owl:Class ;
    core:dataCategory core:data-principal-identity ;
    rdfs:isDefinedBy <https://w3id.org/examplebank/platform/core> ;
    skos:definition "An entity that can be authenticated and to which authorization decisions apply."@en ;
    vs:term_status "draft" .

core:HumanPrincipal a owl:Class ;
    core:dataCategory core:data-principal-identity ;
    rdfs:subClassOf core:Principal ;
    skos:definition "A principal representing a human user, identified via the firm's directory (e.g., SID/HR identifier)."@en ;
    vs:term_status "draft" .

core:WorkloadPrincipal a owl:Class ;
    core:dataCategory core:data-principal-identity ;
    dct:conformsTo <https://github.com/spiffe/spiffe/blob/main/standards/SPIFFE-ID.md> ;
    rdfs:subClassOf core:Principal ;
    skos:definition "A principal representing a non-human workload (service, agent, job), identified via a workload identity such as a SPIFFE ID."@en ;
    vs:term_status "draft" .

core:Resource a owl:Class ;
    core:dataCategory core:data-governance ;
    skos:definition "Anything access to which is governed by policy: services, routes, data assets, control-plane operations."@en ;
    vs:term_status "draft" .

core:PlatformEvent a owl:Class ;
    dct:conformsTo <https://www.w3.org/TR/prov-o/> ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "An auditable occurrence on the platform. Subclassed by domain modules (AuthenticationEvent, PolicyDecision, PolicyChangeEvent)."@en ;
    vs:term_status "draft" .

core:PolicyDecisionPoint a owl:Class ;
    core:dataCategory core:data-governance ;
    dct:conformsTo <https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html> ;
    skos:definition "Component that evaluates policy and renders authorization decisions (XACML PDP)."@en ;
    vs:term_status "draft" .

core:PolicyEnforcementPoint a owl:Class ;
    core:dataCategory core:data-governance ;
    dct:conformsTo <https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html> ;
    skos:definition "Component that intercepts access and enforces PDP decisions (XACML PEP)."@en ;
    vs:term_status "draft" .

core:PolicyInformationPoint a owl:Class ;
    core:dataCategory core:data-governance ;
    dct:conformsTo <https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html> ;
    skos:definition "Component that supplies attribute values used in policy evaluation (XACML PIP)."@en ;
    vs:term_status "draft" .

core:PolicyAdministrationPoint a owl:Class ;
    core:dataCategory core:data-governance ;
    dct:conformsTo <https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html> ;
    skos:definition "Component through which policy is authored and managed (XACML PAP)."@en ;
    vs:term_status "draft" .

core:Tenant a owl:Class ;
    core:dataCategory core:data-governance ;
    skos:definition "An organizational unit onboarded to the platform, to which subscriptions, applications, entitlement grants, and data planes are scoped."@en ;
    vs:term_status "draft" .

core:PlatformTenant a owl:Class ;
    core:dataCategory core:data-governance ;
    rdfs:subClassOf core:Tenant ;
    skos:definition "The distinguished singleton tenant representing the platform itself. Platform-owned applications are owned by it, and it holds capability subscriptions like any tenant, keeping every ownership and coverage rule uniform. Exactly one individual is expected (stewardship-enforced)."@en ;
    vs:term_status "draft" .

core:Capability a owl:Class ;
    core:dataCategory core:data-governance ;
    skos:definition "A platform offering provided to tenants via subscription. Each capability is governed by exactly one capability control plane."@en ;
    vs:term_status "draft" .

core:Application a owl:Class ;
    core:dataCategory core:data-governance ;
    rdfs:subClassOf core:Resource ;
    skos:definition "An independently developed application owned by exactly one tenant, reachable through ingress once enabled, and consuming platform capabilities per its confirmed requirements."@en ;
    skos:editorialNote "What a subject may do inside the application is application-owned (Level 3) and deliberately out of this ontology's scope."@en ;
    vs:term_status "draft" .

core:BusinessClient a owl:Class ;
    core:dataCategory core:data-customer-personal ;
    skos:prefLabel "Business client"@en ;
    skos:altLabel "customer"@en , "counterparty"@en ;
    skos:definition "A party holding a business relationship with the firm — the firm's customer, retail or corporate. A business client is not itself authenticable; principals act for it, which is what lets one corporate client have many users and one person hold both a staff identity and a client relationship."@en ;
    skos:editorialNote "This is the word 'client' in its business sense, and the ontology reserves it for that meaning alone. The OAuth client registration is a different and unrelated thing — see authn:OAuthClientRegistration."@en ;
    vs:term_status "draft" .

core:DeliveryChannel a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The delivery avenue through which platform capabilities are consumed, never a self-asserted claim. For interactive sessions it follows from the session's device class. Members are individuals in a closed, platform-owned scheme."@en ;
    vs:term_status "draft" .

# Disjointness — cheapest consistency checks under reasoning
[] a owl:AllDisjointClasses ;
   owl:members ( core:Principal core:Resource core:PlatformEvent ) .

core:HumanPrincipal owl:disjointWith core:WorkloadPrincipal .
core:Tenant owl:disjointWith core:Capability .
core:PolicyDecisionPoint owl:disjointWith core:PolicyEnforcementPoint .

#################################################################
# Object properties
#################################################################

core:performedBy a owl:ObjectProperty ;
    dct:conformsTo <https://www.w3.org/TR/prov-o/> ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    skos:definition "Links a platform event to the principal that performed it. Typing enforced in SHACL, not via rdfs:domain/range."@en ;
    vs:term_status "draft" .

core:targetsResource a owl:ObjectProperty ;
    dct:conformsTo <https://docs.oasis-open.org/xacml/3.0/xacml-3.0-core-spec-os-en.html> ;
    skos:altLabel "resource (XACML)"@en ;
    skos:definition "Links an event or policy to the resource it concerns."@en ;
    vs:term_status "draft" .

core:governedBy a owl:ObjectProperty ;
    skos:definition "Links a resource to a policy that governs access to it."@en ;
    vs:term_status "draft" .

core:enforcedBy a owl:ObjectProperty ;
    skos:definition "Links a resource or route to the policy enforcement point that mediates access to it."@en ;
    vs:term_status "draft" .

core:ownedBy a owl:ObjectProperty ;
    skos:definition "Tenant that owns an application or portal — exactly one (enforced in SHACL); ownership transfer is a supersession of declarations, never co-ownership. Platform assets are owned by the distinguished platform tenant."@en ;
    vs:term_status "draft" .

core:actsForClient a owl:ObjectProperty ;
    skos:definition "Business client a principal acts for. Retail relationships are typically one principal to one client; corporate relationships many principals to one."@en ;
    skos:editorialNote "Distinct from tenant membership. Whether a business client is ever also a tenant is deliberately left open."@en ;
    vs:term_status "draft" .

core:hasActingIdentity a owl:ObjectProperty ;
    dct:conformsTo <https://github.com/spiffe/spiffe/blob/main/standards/SPIFFE-ID.md> ;
    skos:definition "Principal under whose identity a resource acts — a control plane component's SPIFFE workload identity, for example. Resources cannot be principals; their acts are performed by this principal. Promoted from control-plane while draft."@en ;
    vs:term_status "draft" .

#################################################################
# Datatype properties
#################################################################

core:identifier a owl:DatatypeProperty ;
    dct:conformsTo <https://github.com/spiffe/spiffe/blob/main/standards/SPIFFE-ID.md> ;
    skos:definition "The canonical identifier for this entity in the firm's registry for its kind — a SPIFFE ID, a directory identifier, a customer identifier, a device registration."@en ;
    vs:term_status "draft" .

core:occurredAtTime a owl:DatatypeProperty ;
    dct:conformsTo <https://www.w3.org/TR/prov-o/> ;
    rdfs:subPropertyOf prov:startedAtTime ;
    skos:definition "Timestamp at which a platform event occurred."@en ;
    vs:term_status "draft" .

core:displayName a owl:DatatypeProperty ;
    skos:definition "Human-readable label for governance and stewardship UIs."@en ;
    vs:term_status "draft" .

core:validFrom a owl:DatatypeProperty ;
    skos:definition "Start of a validity window (attribute assertions, subscriptions, subject identifiers). Promoted from authz while draft — generic temporal vocabulary belongs in the upper module."@en ;
    vs:term_status "draft" .

core:validUntil a owl:DatatypeProperty ;
    skos:definition "End of a validity window."@en ;
    vs:term_status "draft" .

#################################################################
# Delivery channel vocabulary (closed; extension is a MINOR bump)
#################################################################

core:DeliveryChannelScheme a skos:ConceptScheme ;
    dct:title "Platform Delivery Channels"@en .

core:channel-web a core:DeliveryChannel ;
    skos:inScheme core:DeliveryChannelScheme ;
    skos:prefLabel "Web"@en .

core:channel-mobile a core:DeliveryChannel ;
    skos:inScheme core:DeliveryChannelScheme ;
    skos:prefLabel "Mobile"@en .

core:channel-api a core:DeliveryChannel ;
    skos:inScheme core:DeliveryChannelScheme ;
    skos:prefLabel "API (credentialed integration)"@en .

core:channel-agent a core:DeliveryChannel ;
    skos:inScheme core:DeliveryChannelScheme ;
    skos:prefLabel "AI agent"@en ;
    skos:editorialNote "Delegation semantics deliberately deferred; see the agent-channel backlog questions."@en .

#################################################################
# Data categories — kind, not sensitivity (D63)
#################################################################

core:DataCategory a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    skos:prefLabel "Data category"@en ;
    skos:definition "The kind of data a stored fact or a data plane holds, from the closed scheme; the axis residency, sovereignty, retention and minimisation are stated against. Kind, not sensitivity."@en ;
    vs:term_status "draft" .

core:dataCategory a owl:AnnotationProperty ;
    skos:prefLabel "data category"@en ;
    skos:definition "Data category of the instances of a class — an annotation on the class, so the ontology's own contents are classified."@en ;
    vs:term_status "draft" .

core:DataCategoryScheme a skos:ConceptScheme ; skos:prefLabel "Data categories"@en ;
    skos:definition "Closed scheme of the kinds of data the platform holds or hosts. Extend by decision, never by string."@en .

core:data-customer-personal a core:DataCategory ; skos:inScheme core:DataCategoryScheme ;
    dct:conformsTo <https://eur-lex.europa.eu/eli/reg/2016/679/oj> ;
    skos:prefLabel "Customer personal data"@en ; skos:notation "customer-personal" ;
    skos:definition "Data about business clients and the people behind them — personal data in the regulation's sense, held in tenant data planes."@en .
core:data-principal-identity a core:DataCategory ; skos:inScheme core:DataCategoryScheme ;
    dct:conformsTo <https://eur-lex.europa.eu/eli/reg/2016/679/oj> ;
    skos:prefLabel "Principal identity data"@en ; skos:notation "principal-identity" ;
    skos:definition "Data about principals held by the platform itself: subject identifiers, credentials, proof-of-possession keys, memberships."@en .
core:data-authn-evidence a core:DataCategory ; skos:inScheme core:DataCategoryScheme ;
    skos:prefLabel "Authentication and session evidence"@en ; skos:notation "authn-evidence" ;
    skos:definition "Authentication events, journey executions, sessions, tokens and devices — security evidence that exists for traceability."@en .
core:data-authz-evidence a core:DataCategory ; skos:inScheme core:DataCategoryScheme ;
    skos:prefLabel "Authorization evidence"@en ; skos:notation "authz-evidence" ;
    skos:definition "Decisions, entitlement grants and attribute assertions."@en .
core:data-governance a core:DataCategory ; skos:inScheme core:DataCategoryScheme ;
    skos:prefLabel "Governance records"@en ; skos:notation "governance" ;
    skos:definition "Declarations, approvals, subscriptions, offerings, commitments, contracts and configuration — retained for audit."@en .
core:data-observations a core:DataCategory ; skos:inScheme core:DataCategoryScheme ;
    skos:prefLabel "Operational observations"@en ; skos:notation "observations" ;
    skos:definition "Windowed aggregates of capability use and of commitment metrics — never per-request."@en .
core:data-tenant-workload a core:DataCategory ; skos:inScheme core:DataCategoryScheme ;
    skos:prefLabel "Tenant workload data"@en ; skos:notation "tenant-workload" ;
    skos:definition "The contents of data planes serving tenants — hosted by the platform without being understood by it. Residency and sovereignty apply by category alone."@en .

#################################################################
# Jurisdiction, region, legal entity (D64)
#################################################################

core:Jurisdiction a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    core:dataCategory core:data-governance ;
    skos:prefLabel "Jurisdiction"@en ;
    skos:definition "A legal or regulatory authority that governs data or processing. Jurisdictions nest: a narrower one sits inside a broader one (skos:broader)."@en ;
    vs:term_status "draft" .

core:Region a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    core:dataCategory core:data-governance ;
    skos:prefLabel "Region"@en ;
    skos:definition "Where a data plane or application is physically or logically deployed, at deployment-region granularity. A region lies in one or more jurisdictions."@en ;
    vs:term_status "draft" .

core:LegalEntity a owl:Class ;
    core:dataCategory core:data-governance ;
    skos:prefLabel "Legal entity"@en ;
    skos:definition "A legal person under a jurisdiction's law that operates workloads or data planes. Sovereignty follows the operator's jurisdiction, not the region."@en ;
    vs:term_status "draft" .

core:inJurisdiction a owl:ObjectProperty ;
    skos:prefLabel "in jurisdiction"@en ;
    skos:definition "Jurisdiction a region lies in — one or more."@en ;
    vs:term_status "draft" .

core:underJurisdiction a owl:ObjectProperty ;
    skos:prefLabel "under jurisdiction"@en ;
    skos:definition "Jurisdiction whose law a legal entity is under."@en ;
    vs:term_status "draft" .

core:operatedBy a owl:ObjectProperty ;
    skos:prefLabel "operated by"@en ;
    skos:definition "Legal entity that operates a data plane or a workload principal — the accountability for operation, distinct from the authority the thing holds (D61)."@en ;
    vs:term_status "draft" .

core:JurisdictionScheme a skos:ConceptScheme ; skos:prefLabel "Jurisdictions"@en ;
    skos:definition "Closed scheme of jurisdictions the platform reasons about. Extend by decision."@en .
core:jurisdiction-us a core:Jurisdiction ; skos:inScheme core:JurisdictionScheme ; skos:prefLabel "United States"@en ; skos:notation "US" .
core:jurisdiction-us-ca a core:Jurisdiction ; skos:inScheme core:JurisdictionScheme ; skos:broader core:jurisdiction-us ; skos:prefLabel "California"@en ; skos:notation "US-CA" .
core:jurisdiction-eu a core:Jurisdiction ; skos:inScheme core:JurisdictionScheme ; skos:prefLabel "European Union"@en ; skos:notation "EU" .
core:jurisdiction-de a core:Jurisdiction ; skos:inScheme core:JurisdictionScheme ; skos:broader core:jurisdiction-eu ; skos:prefLabel "Germany"@en ; skos:notation "DE" .
core:jurisdiction-ie a core:Jurisdiction ; skos:inScheme core:JurisdictionScheme ; skos:broader core:jurisdiction-eu ; skos:prefLabel "Ireland"@en ; skos:notation "IE" .
core:jurisdiction-ch a core:Jurisdiction ; skos:inScheme core:JurisdictionScheme ; skos:prefLabel "Switzerland"@en ; skos:notation "CH" .

core:RegionScheme a skos:ConceptScheme ; skos:prefLabel "Deployment regions"@en ;
    skos:definition "Closed scheme of deployment regions. Replaces the free-string region facet (P16)."@en .
core:region-us-west-2 a core:Region ; skos:inScheme core:RegionScheme ; core:inJurisdiction core:jurisdiction-us ; skos:prefLabel "us-west-2"@en ; skos:notation "us-west-2" .
core:region-us-west-1 a core:Region ; skos:inScheme core:RegionScheme ; core:inJurisdiction core:jurisdiction-us , core:jurisdiction-us-ca ; skos:prefLabel "us-west-1"@en ; skos:notation "us-west-1" .
core:region-eu-central-1 a core:Region ; skos:inScheme core:RegionScheme ; core:inJurisdiction core:jurisdiction-eu , core:jurisdiction-de ; skos:prefLabel "eu-central-1"@en ; skos:notation "eu-central-1" .
core:region-eu-west-1 a core:Region ; skos:inScheme core:RegionScheme ; core:inJurisdiction core:jurisdiction-eu , core:jurisdiction-ie ; skos:prefLabel "eu-west-1"@en ; skos:notation "eu-west-1" .

