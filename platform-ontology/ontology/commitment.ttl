@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix vs:    <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix core:  <https://w3id.org/examplebank/platform/core#> .
@prefix cp:    <https://w3id.org/examplebank/platform/control-plane#> .
@prefix cmt:   <https://w3id.org/examplebank/platform/commitment#> .

<https://w3id.org/examplebank/platform/commitment>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/examplebank/platform/commitment/0.6.0> ;
    owl:versionInfo "0.6.0" ;
    owl:imports <https://w3id.org/examplebank/platform/core> , <https://w3id.org/examplebank/platform/control-plane> ;
    dct:conformsTo <https://www.w3.org/TR/owl2-profiles/#OWL_2_QL> , <https://www.w3.org/TR/vocab-ssn/> ;
    dct:title "Commitment Module"@en ;
    dct:description "Non-functional commitments a capability offering carries — one metric, a target with unit and comparator over a window, a measurement source and a validation mechanism — and the windowed observations that evidence them. A sibling of the identity modules: it imports core and control-plane and nothing imports it. Vocabulary from specifications: SOSA/SSN for observable properties and observations, QUDT for units. Scaffolded at 0.1.0 (D58) with one competency question; measurements never enter per-request. Since 0.2.0: a commitment is a desired-state declaration (D59) — it is declared through the management plane, bound to a scope that contains its offering's scope, approved where the scope requires it, and superseded rather than edited. Since 0.3.0: baselines — floors declared at a scope that every offering beneath must meet with a commitment at least as strong (D66). Since 0.4.0: three metrics the platform questions asked for — failover success ratio, change-failure rate, time to restore redundancy (D67). Since 0.5.0: a commitment or baseline records the reason for its target, citing the decisions it rests on (D72). Since 0.6.0: a metric states when it applies to a capability (D74), and a capability requirement states the minimum it needs on a metric, which an available offering covering the requirement's enablement must promise (D75)."@en ;
    dct:created "2026-09-02"^^xsd:date .

#################################################################
# Classes
#################################################################

cmt:Commitment a owl:Class ;
    core:dataCategory core:data-governance ;
    rdfs:subClassOf cp:DesiredStateDeclaration ;
    skos:prefLabel "Commitment"@en ;
    skos:altLabel "service-level objective"@en , "non-functional requirement"@en ;
    skos:definition "A desired-state declaration of a non-functional guarantee for a capability offering: one metric, a target with unit and comparator over a window, a measurement source, and a validation mechanism."@en ;
    vs:term_status "draft" .

cmt:Observation a owl:Class ;
    core:dataCategory core:data-observations ;
    rdfs:subClassOf sosa:Observation ;
    dct:conformsTo <https://www.w3.org/TR/vocab-ssn/> ;
    skos:prefLabel "Observation"@en ;
    skos:definition "A windowed aggregate measurement of a commitment's metric, ingested from telemetry. Never per-request: the graph holds evidence, not time series."@en ;
    vs:term_status "draft" .

cmt:MeasurementSource a owl:Class ;
    core:dataCategory core:data-governance ;
    skos:prefLabel "Measurement source"@en ;
    skos:definition "A system or feed from which a commitment's metric is observed. Instances may name the actual monitoring system; the term does not."@en ;
    vs:term_status "draft" .

cmt:Metric a owl:Class ;
    rdfs:subClassOf sosa:ObservableProperty , skos:Concept ;
    dct:conformsTo <https://www.w3.org/TR/vocab-ssn/> ;
    skos:prefLabel "Metric"@en ;
    skos:definition "An observable property a commitment targets, drawn from the closed metric scheme."@en ;
    vs:term_status "draft" .

cmt:Comparator a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    skos:prefLabel "Comparator"@en ;
    skos:definition "How an observed value is judged against a target: at least, or at most."@en ;
    vs:term_status "draft" .

cmt:CommitmentState a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    skos:prefLabel "Commitment state"@en ;
    skos:definition "Lifecycle state of a commitment: draft, committed, or withdrawn."@en ;
    vs:term_status "draft" .

cmt:Commitment owl:disjointWith cmt:Observation .

#################################################################
# Object properties (no domain/range — typing is SHACL's job, P6)
#################################################################

cmt:commitsTo a owl:ObjectProperty ;
    skos:prefLabel "commits to"@en ;
    skos:definition "Capability offering a commitment is made for. The offering carries the scope; the commitment inherits it."@en ;
    vs:term_status "draft" .

cmt:metric a owl:ObjectProperty ;
    skos:prefLabel "metric"@en ;
    skos:definition "Metric a commitment targets — exactly one, from the closed scheme."@en ;
    vs:term_status "draft" .

cmt:unit a owl:ObjectProperty ;
    dct:conformsTo <https://qudt.org/> ;
    skos:prefLabel "unit"@en ;
    skos:definition "QUDT unit the target is expressed in."@en ;
    vs:term_status "draft" .

cmt:comparator a owl:ObjectProperty ;
    skos:prefLabel "comparator"@en ;
    skos:definition "Comparator judging observations against the target."@en ;
    vs:term_status "draft" .

cmt:measuredBy a owl:ObjectProperty ;
    skos:prefLabel "measured by"@en ;
    skos:definition "Measurement source the commitment's metric is observed from — at least one, or the commitment is aspirational."@en ;
    vs:term_status "draft" .

cmt:hasCommitmentState a owl:ObjectProperty ;
    skos:prefLabel "has commitment state"@en ;
    skos:definition "Current lifecycle state of the commitment."@en ;
    vs:term_status "draft" .

cmt:observationOf a owl:ObjectProperty ;
    skos:prefLabel "observation of"@en ;
    skos:definition "Commitment an observation evidences."@en ;
    vs:term_status "draft" .

#################################################################
# Datatype properties
#################################################################

cmt:target a owl:DatatypeProperty ;
    skos:prefLabel "target"@en ;
    skos:definition "Target value of the commitment, in its unit."@en ;
    vs:term_status "draft" .

cmt:window a owl:DatatypeProperty ;
    skos:prefLabel "window"@en ;
    skos:definition "Duration over which the target is judged, as an xsd:duration."@en ;
    vs:term_status "draft" .

cmt:validatedBy a owl:DatatypeProperty ;
    skos:prefLabel "validated by"@en ;
    skos:definition "Reference to the mechanism that validates observations against the target — a query in this repository, or an external check. At least one, or the commitment is aspirational."@en ;
    vs:term_status "draft" .

cmt:rationale a owl:DatatypeProperty ;
    skos:prefLabel "rationale"@en ;
    skos:definition "The recorded reason a commitment or baseline carries the target it does, as text that cites by identifier the decisions it rests on."@en ;
    skos:example "D71: covers TLS termination, tenant resolution and the decision call; 50 ms of the 300 ms floor."@en ;
    vs:term_status "draft" .

#################################################################
# Closed schemes (P7)
#################################################################

cmt:MetricScheme a skos:ConceptScheme ; skos:prefLabel "Commitment metrics"@en ;
    skos:definition "Closed scheme of metrics a commitment may target. Extend by decision, never by string."@en .
cmt:metric-availability a cmt:Metric ; skos:inScheme cmt:MetricScheme ; skos:prefLabel "Availability"@en ; skos:notation "availability" ; cmt:appliesWhen cmt:applies-always .
cmt:metric-latency-p99 a cmt:Metric ; skos:inScheme cmt:MetricScheme ; skos:prefLabel "Latency, 99th percentile"@en ; skos:notation "latency.p99" ; cmt:appliesWhen cmt:applies-always .
cmt:metric-recovery-time a cmt:Metric ; skos:inScheme cmt:MetricScheme ; skos:prefLabel "Recovery time objective"@en ; skos:notation "rto" ; cmt:appliesWhen cmt:applies-always .
cmt:metric-recovery-point a cmt:Metric ; skos:inScheme cmt:MetricScheme ; skos:prefLabel "Recovery point objective"@en ; skos:notation "rpo" ; cmt:appliesWhen cmt:applies-when-holding-data .
cmt:metric-failover-success-ratio a cmt:Metric ; skos:inScheme cmt:MetricScheme ; skos:prefLabel "Successful-request ratio during failover"@en ; skos:notation "failover.success-ratio" ; cmt:appliesWhen cmt:applies-when-multi-region ;
    skos:definition "Share of requests that succeed while a failover is in progress — the 'will users lose requests' question (D67)."@en .
cmt:metric-change-failure-rate a cmt:Metric ; skos:inScheme cmt:MetricScheme ; skos:prefLabel "Change-failure rate"@en ; skos:notation "change.failure-rate" ; cmt:appliesWhen cmt:applies-always ;
    skos:definition "Share of changes taking effect in a scope that are followed by a commitment breach in the next window — the 'evolve without disrupting users' question (D67)."@en .
cmt:metric-time-to-restore-redundancy a cmt:Metric ; skos:inScheme cmt:MetricScheme ; skos:prefLabel "Time to restore redundancy"@en ; skos:notation "redundancy.restore-time" ; cmt:appliesWhen cmt:applies-when-multi-region ;
    skos:definition "Time from losing a region until the offering again has a failover target — the 'operational safety margin' question (D67)."@en .

cmt:ComparatorScheme a skos:ConceptScheme ; skos:prefLabel "Comparators"@en .
cmt:at-least a cmt:Comparator ; skos:inScheme cmt:ComparatorScheme ; skos:prefLabel "at least"@en ; skos:notation ">=" .
cmt:at-most a cmt:Comparator ; skos:inScheme cmt:ComparatorScheme ; skos:prefLabel "at most"@en ; skos:notation "<=" .

cmt:CommitmentStateScheme a skos:ConceptScheme ; skos:prefLabel "Commitment states"@en .
cmt:state-draft a cmt:CommitmentState ; skos:inScheme cmt:CommitmentStateScheme ; skos:prefLabel "draft"@en .
cmt:state-committed a cmt:CommitmentState ; skos:inScheme cmt:CommitmentStateScheme ; skos:prefLabel "committed"@en .
cmt:state-withdrawn a cmt:CommitmentState ; skos:inScheme cmt:CommitmentStateScheme ; skos:prefLabel "withdrawn"@en .

#################################################################
# When a metric applies (D74) — advice to a capability owner, derived from what
# the capability holds and where it is offered; never an obligation by itself.
#################################################################

cmt:Applicability a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    skos:prefLabel "Applicability"@en ;
    skos:definition "A condition under which a metric carries information for a capability, drawn from the closed applicability scheme."@en ;
    vs:term_status "draft" .

cmt:appliesWhen a owl:ObjectProperty ;
    skos:prefLabel "applies when"@en ;
    skos:definition "Applicability condition of a metric — exactly one, from the closed scheme."@en ;
    vs:term_status "draft" .

cmt:ApplicabilityScheme a skos:ConceptScheme ; skos:prefLabel "Metric applicability"@en ;
    skos:definition "Closed scheme of the conditions under which a metric applies to a capability. Extend by decision, never by string."@en .
cmt:applies-always a cmt:Applicability ; skos:inScheme cmt:ApplicabilityScheme ; skos:prefLabel "always"@en ; skos:notation "always" ;
    skos:definition "Applies to every capability, whatever it holds and wherever it is offered."@en .
cmt:applies-when-holding-data a cmt:Applicability ; skos:inScheme cmt:ApplicabilityScheme ; skos:prefLabel "when holding data"@en ; skos:notation "holds-data" ;
    skos:definition "Applies to a capability whose realising data planes hold a data category; a capability holding nothing meets a floor on the metric by promising zero."@en .
cmt:applies-when-multi-region a cmt:Applicability ; skos:inScheme cmt:ApplicabilityScheme ; skos:prefLabel "when offered in more than one region"@en ; skos:notation "multi-region" ;
    skos:definition "Applies to a capability offered in more than one region; a single-region offering has no failover to measure."@en .

#################################################################
# What a consumer needs (D75) — the demand side of a promise
#################################################################

cmt:CommitmentNeed a owl:Class ;
    core:dataCategory core:data-governance ;
    skos:prefLabel "Commitment need"@en ;
    skos:altLabel "consumer requirement"@en ;
    skos:definition "A minimum a capability requirement states for one metric of the capability it requires: metric, comparator, target and unit, stated in the unit the offering promises in."@en ;
    vs:term_status "draft" .

cmt:hasNeed a owl:ObjectProperty ;
    skos:prefLabel "has need"@en ;
    skos:definition "Need a capability requirement states — any number, at most one per metric; approved with the requirement, never on its own."@en ;
    vs:term_status "draft" .

#################################################################
# Baselines — floors declared at a scope (D66)
#################################################################

cmt:CommitmentBaseline a owl:Class ;
    rdfs:subClassOf cp:DesiredStateDeclaration ;
    core:dataCategory core:data-governance ;
    skos:prefLabel "Commitment baseline"@en ;
    skos:altLabel "floor"@en , "baseline NFR"@en ;
    skos:definition "A floor declared at a scope: one metric, a comparator, a target with unit, and a window, that every offering in the scope's subtree must meet with a committed commitment at least as strong. A requirement, not a promise: it needs no measurement source."@en ;
    vs:term_status "draft" .

cmt:satisfiesBaseline a owl:ObjectProperty ;
    skos:prefLabel "satisfies baseline"@en ;
    skos:definition "Baseline a commitment was made to meet — an optional derivation edge; containment binds them whether or not it is stated."@en ;
    vs:term_status "draft" .

cmt:referenceSource a owl:DatatypeProperty ;
    skos:prefLabel "reference source"@en ;
    skos:definition "Where a baseline's target comes from, as an xsd:anyURI — an industry benchmark, a regulation, or an internal standard."@en ;
    vs:term_status "draft" .

