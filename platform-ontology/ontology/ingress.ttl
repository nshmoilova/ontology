@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix core:    <https://w3id.org/examplebank/platform/core#> .
@prefix ingress: <https://w3id.org/examplebank/platform/ingress#> .
@prefix vs:      <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

<https://w3id.org/examplebank/platform/ingress>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/examplebank/platform/ingress/0.3.0> ;
    owl:versionInfo "0.3.0" ;
    owl:imports <https://w3id.org/examplebank/platform/core> ;
    dct:title "Ingress Module"@en ;
    dct:description "Gateways, listeners, routes, TLS termination, and upstream services. Deliberately implementation-independent: the terms describe the network entry model itself, not any particular gateway product or API. Since 0.2.0: route matching by domain and path, and the binding from a route to the tenant it serves — the configuration from which ingress resolves tenant context, and therefore the root of tenant.access. Since 0.3.0: the application a route serves, which completes the route as an application access endpoint."@en .

#################################################################
# Classes
#################################################################

ingress:Gateway a owl:Class ;
    rdfs:subClassOf core:Resource ;
    skos:definition "A network entry point into the platform, exposing one or more listeners through which external traffic arrives."@en ;
    vs:term_status "draft" .

ingress:Listener a owl:Class ;
    skos:definition "A protocol/port binding on a gateway."@en ;
    vs:term_status "draft" .

ingress:Route a owl:Class ;
    rdfs:subClassOf core:Resource ;
    skos:prefLabel "Route"@en ;
    skos:altLabel "application access endpoint"@en ;
    skos:definition "A rule mapping matched traffic on a gateway to an upstream service. A route that binds a tenant and serves an application is the addressable endpoint through which that application is entered: it carries the domain and path, the tenant binding, the mediating enforcement point, and a governed declaration behind the binding."@en ;
    vs:term_status "draft" .

ingress:UpstreamService a owl:Class ;
    rdfs:subClassOf core:Resource ;
    skos:definition "A backend service to which routes forward traffic."@en ;
    vs:term_status "draft" .

ingress:TLSConfiguration a owl:Class ;
    skos:definition "TLS settings applied at a listener, including where TLS terminates relative to policy enforcement."@en ;
    vs:term_status "draft" .

#################################################################
# Object properties
#################################################################

ingress:hasListener a owl:ObjectProperty ;
    skos:definition "Listener exposed by a gateway."@en ;
    vs:term_status "draft" .

ingress:exposesRoute a owl:ObjectProperty ;
    skos:definition "Route attached to a gateway or listener."@en ;
    vs:term_status "draft" .

ingress:routesTo a owl:ObjectProperty ;
    skos:definition "Upstream service to which a route forwards traffic."@en ;
    vs:term_status "draft" .

ingress:boundToTenant a owl:ObjectProperty ;
    skos:definition "Tenant that traffic matching this route resolves to. Ingress establishes tenant context from this binding, not from any token claim."@en ;
    vs:term_status "draft" .

ingress:servesApplication a owl:ObjectProperty ;
    skos:definition "Application reachable through this route. With the tenant binding, this makes the route the endpoint an application is entered at, so admission can ask whether a subject may enter THIS application through THIS endpoint rather than merely whether the tenant owns some enabled application."@en ;
    vs:term_status "draft" .

ingress:hasTLSConfiguration a owl:ObjectProperty ;
    skos:definition "TLS configuration applied to a listener."@en ;
    vs:term_status "draft" .

#################################################################
# Datatype properties
#################################################################

ingress:port a owl:DatatypeProperty ;
    skos:definition "Port number of a listener."@en ;
    vs:term_status "draft" .

ingress:protocol a owl:DatatypeProperty ;
    skos:definition "Protocol of a listener (HTTPS, TLS, TCP)."@en ;
    vs:term_status "draft" .

ingress:terminatesTLS a owl:DatatypeProperty ;
    skos:definition "Whether TLS terminates at this listener (true) or is passed through (false)."@en ;
    vs:term_status "draft" .

ingress:hostname a owl:DatatypeProperty ;
    skos:definition "Domain a route matches. Together with the path prefix it forms the address a tenant is reached at; a tenant-bound route must carry one (enforced in SHACL)."@en ;
    vs:term_status "draft" .

ingress:pathPrefix a owl:DatatypeProperty ;
    skos:definition "Path prefix a route matches within its domain. Absent means the whole domain; present, it lets one domain serve several tenants or applications at different paths."@en ;
    vs:term_status "draft" .
