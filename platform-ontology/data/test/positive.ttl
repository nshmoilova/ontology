    ctr:versionOf ex:contract-cap-decision ;
    ctr:versionString "1.0.0" ;
    ctr:hasVersionState ctr:state-published ;
    ctr:compatibility ctr:compatible ;
    ctr:artifact "https://contracts.example/platform/cap-decision/1.0.0/openapi.yaml"^^xsd:anyURI .
ex:contract-change-cap-decision a ctr:ContractChange ;
    core:displayName "Publish authorization decision contract 1.0.0" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-contract-cap-decision ;
    ctr:publishesVersion ex:contract-cap-decision-v1 .
ex:approval-contract-cap-decision a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-09-02T10:00:00Z"^^xsd:dateTime .
ex:commit-cap-decision-availability a cmt:Commitment ;
    core:displayName "Authorization decision: availability at least 99.99 %" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-commit-cap-decision-availability ;
    cmt:commitsTo ex:offering-cap-decision-prod ;
    cmt:rationale "D76: fails with ingress in practice, so it promises what ingress promises; 99.99 percent needs zonal redundancy and a grant projection that survives a control-plane outage." ;
    cmt:metric cmt:metric-availability ;
    cmt:comparator cmt:at-least ;
    cmt:target 99.99 ;
    cmt:unit unit:PERCENT ;
    cmt:window "P30D"^^xsd:duration ;
    cmt:measuredBy ex:source-platform-metrics ;
    cmt:validatedBy "queries/competency/cq16-commitment-status.rq"^^xsd:anyURI ;
    cmt:satisfiesBaseline ex:floor-prod-availability ;
