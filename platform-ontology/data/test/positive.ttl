    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-09-03T12:00:00Z"^^xsd:dateTime .
ex:commit-cap-decision-rpo a cmt:Commitment ;
    core:displayName "Authorization decision: recovery point at most 0.0 minutes" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-commit-cap-decision-rpo ;
    cmt:commitsTo ex:offering-cap-decision-prod ;
