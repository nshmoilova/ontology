    cmt:comparator cmt:at-most ;
    cmt:target 0.0 ;
    cmt:unit unit:MIN ;
    cmt:window "P90D"^^xsd:duration ;
    cmt:measuredBy ex:source-platform-metrics ;
    cmt:validatedBy "queries/competency/cq16-commitment-status.rq"^^xsd:anyURI ;
