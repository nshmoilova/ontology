# Seed instance data expected to CONFORM (violations: none; warnings acceptable).
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix core:    <https://w3id.org/examplebank/platform/core#> .
@prefix authn:   <https://w3id.org/examplebank/platform/authn#> .
@prefix session: <https://w3id.org/examplebank/platform/session#> .
@prefix ingress: <https://w3id.org/examplebank/platform/ingress#> .
@prefix authz:   <https://w3id.org/examplebank/platform/authz#> .
@prefix cp:      <https://w3id.org/examplebank/platform/control-plane#> .
@prefix ex:      <https://data.examplebank.com/platform/> .
@prefix cmt:  <https://w3id.org/examplebank/platform/commitment#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix ctr:  <https://w3id.org/examplebank/platform/contract#> .

### Principals
ex:alice a core:HumanPrincipal ;
    core:identifier "dir:alice.chen" ;
    core:displayName "Alice Chen" .

ex:payments-agent a core:WorkloadPrincipal ;
    core:identifier "spiffe://examplebank.com/ns/payments/sa/agent-runner" ;
    core:displayName "Payments agent runner" .

### The two clients, kept apart
### 1. OAuth client — the session manager's registration, one per audience
ex:oauth-reg-transaction a authn:OAuthClientRegistration ;
    core:displayName "Session manager registration for the transaction audience" ;
    authn:clientId "a3f1c8e2-7d44-4b91-9f0e-2c6b5d18ae37" ;
    authn:registeredWith ex:enterprise-idp ;
    authn:forAudience ex:transaction-service .

### 2. Business client — a party with a relationship to the firm
ex:client-acme a core:BusinessClient ;
    core:identifier "cif:8840127" ;
    core:displayName "Acme Trading Ltd" .

ex:dana a core:HumanPrincipal ;
    core:identifier "cust:dana.okafor" ;
    core:displayName "Dana Okafor" ;
    core:actsForClient ex:client-acme .

### Identity provider & credentials
ex:enterprise-idp a authn:IdentityProvider ;
    core:displayName "Enterprise IdP" .

ex:alice-passkey a authn:Credential ;
    authn:credentialOf ex:alice ;
    authn:issuedBy ex:enterprise-idp .

### Subject identifiers
ex:subid-alice-idp a authn:SubjectIdentifier ;
    authn:subjectValue "idp|8842-alice" ;
    authn:atIssuer ex:enterprise-idp ;
    authn:identifies ex:alice ;
    authn:identifierFormat authn:format-iss-sub ;
    core:validFrom "2026-01-15T00:00:00Z"^^xsd:dateTime .

ex:subid-alice-legacy a authn:SubjectIdentifier ;
    authn:subjectValue "legacy-9931-c4e1" ;
    authn:atIssuer ex:enterprise-idp ;
    authn:identifies ex:alice ;
    authn:identifierFormat authn:format-opaque .

### Authentication
ex:authn-1001 a authn:AuthenticationEvent ;
    core:occurredAtTime "2026-08-31T13:05:00Z"^^xsd:dateTime ;
    authn:authenticatedPrincipal ex:alice ;
    authn:usedCredential ex:alice-passkey ;
    authn:usedMethod authn:method-fido2 ;
    authn:succeeded true ;
    authn:achievedAssuranceLevel authn:AAL2 .

### Authentication journey
ex:journey-web-default a authn:AuthenticationJourneyDefinition ;
    core:displayName "Web default journey: FIDO2 passkey, yields AAL2" ;
    authn:servesChannel core:channel-web .

ex:exec-1001 a authn:AuthenticationJourneyExecution ;
    core:occurredAtTime "2026-08-31T13:05:00Z"^^xsd:dateTime ;
    authn:followsDefinition ex:journey-web-default ;
    authn:comprisesEvent ex:authn-1001 ;
    authn:authenticatedPrincipal ex:alice ;
    authn:succeeded true ;
    authn:achievedAssuranceLevel authn:AAL2 .

### An API-channel session: no device, channel from the journey definition
ex:journey-api-client-credentials a authn:AuthenticationJourneyDefinition ;
    core:displayName "API default journey: mutual TLS client credentials" ;
    authn:servesChannel core:channel-api .

ex:authn-2001 a authn:AuthenticationEvent ;
    core:occurredAtTime "2026-08-31T13:00:00Z"^^xsd:dateTime ;
    authn:authenticatedPrincipal ex:payments-agent ;
    authn:usedMethod authn:method-mtls ;
    authn:succeeded true ;
    authn:achievedAssuranceLevel authn:AAL2 .

ex:exec-2001 a authn:AuthenticationJourneyExecution ;
    core:occurredAtTime "2026-08-31T13:00:00Z"^^xsd:dateTime ;
    authn:followsDefinition ex:journey-api-client-credentials ;
    authn:comprisesEvent ex:authn-2001 ;
    authn:authenticatedPrincipal ex:payments-agent ;
    authn:succeeded true ;
    authn:achievedAssuranceLevel authn:AAL2 .

ex:dpop-key-payments-agent a authn:ProofOfPossessionKey ;
    core:displayName "Payments agent key" ;
    authn:keyThumbprint "cM4pT1qLd8vXn2Rb7KfYs0WgEjHu5AoZi3Ncx9QeTvs" ;
    authn:keyAlgorithm "ES256" .

ex:session-9002 a session:Session ;
    core:displayName "API session — channel established by the journey, no device" ;
    session:establishedBy ex:exec-2001 ;
    session:boundToPrincipal ex:payments-agent ;
    session:hasState session:state-active ;
    session:expiresAt "2026-08-31T17:00:00Z"^^xsd:dateTime ;
    authn:confirmedByKey ex:dpop-key-payments-agent .

### Session & tokens — sender-constrained (DPoP, RFC 9449)
ex:dpop-key-alice-web a authn:ProofOfPossessionKey ;
    core:displayName "Alice's web front DPoP key" ;
    authn:keyThumbprint "0ZcOCORZNYy-DWpqq30jZyJGHTN0d2HglBV3uiguA4I" ;
    authn:keyAlgorithm "ES256" .

ex:device-alice-laptop a session:Device ;
    core:identifier "dev:web-client:9f2a41c8" ;
    core:displayName "Alice's browser client" ;
    session:hasDeviceClass session:device-browser .

ex:session-9001 a session:Session ;
    session:establishedBy ex:exec-1001 ;
    session:boundToPrincipal ex:alice ;
    session:onDevice ex:device-alice-laptop ;
    session:hasState session:state-active ;
    session:notBefore "2026-08-31T13:05:01Z"^^xsd:dateTime ;
    session:expiresAt "2026-08-31T21:05:01Z"^^xsd:dateTime ;
    authn:confirmedByKey ex:dpop-key-alice-web ;
    session:issuedToken ex:token-at-1 .

ex:handle-9001 a session:SessionHandle ;
    core:displayName "Session cookie handle" ;
    session:resolvesToSession ex:session-9001 .

ex:token-at-1 a session:AccessToken ;
    session:expiresAt "2026-08-31T13:20:01Z"^^xsd:dateTime ;
    session:tokenAudience ex:transaction-service ;
    authn:confirmedByKey ex:dpop-key-alice-web .

### Ingress — the XACML pair: the platform's decision point and its enforcer
ex:platform-pdp a core:PolicyDecisionPoint ;
    cp:realizesCapability ex:cap-decision ;
    core:displayName "Platform policy decision point" .

ex:pep-edge-east a core:PolicyEnforcementPoint ;
    cp:realizesCapability ex:cap-ingress ;
    core:displayName "Edge enforcement point (east)" .

ex:edge-gateway a ingress:Gateway ;
    core:governedBy ex:policy-ledger-read ;
    ingress:hasListener ex:listener-443 ;
    ingress:exposesRoute ex:route-digital-bank .

ex:listener-443 a ingress:Listener ;
    ingress:port 443 ;
    ingress:protocol "HTTPS" ;
    ingress:terminatesTLS true .

ex:transaction-service a ingress:UpstreamService ;
    core:governedBy ex:policy-ledger-read ;
    core:displayName "Transaction service" .

ex:route-digital-bank a ingress:Route ;
    core:governedBy ex:policy-ledger-read ;
    ingress:routesTo ex:transaction-service ;
    ingress:hostname "t123.apps.examplebank.com" ;
    ingress:pathPrefix "/digital-bank" ;
    ingress:boundToTenant ex:tenant-t123 ;
    ingress:servesApplication ex:app-digital-bank ;
    core:enforcedBy ex:pep-edge-east .

### The route binding is governed desired state, not loose config
ex:route-binding-8003 a cp:RouteBindingChange ;
    core:displayName "Bind t123.apps.examplebank.com/digital-bank to tenant T123" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:declaresRouteBinding ex:route-digital-bank ;
    cp:hasApproval ex:approval-8003 .

ex:approval-8003 a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-28T14:00:00Z"^^xsd:dateTime .

### Authorization
ex:hr-pip a core:PolicyInformationPoint ;
    core:displayName "HR attribute service" .

ex:attr-alice-lob a authz:AttributeAssertion ;
    authz:aboutPrincipal ex:alice ;
    authz:attributeName "lineOfBusiness" ;
    authz:attributeValue "payments" ;
    authz:assertedBy ex:hr-pip ;
    core:validFrom "2026-01-01T00:00:00Z"^^xsd:dateTime ;
    core:validUntil "2026-12-31T23:59:59Z"^^xsd:dateTime .

ex:policy-ledger-read a authz:Policy ;
    core:displayName "Ledger read access" ;
    authz:requiredAssuranceLevel authn:AAL2 ;
    authz:hasRule ex:rule-lob-payments .

ex:rule-lob-payments a authz:PolicyRule ;
    authz:effect "permit" .

ex:policy-platform-admission a authz:Policy ;
    core:displayName "Platform admission policy (realized by distributed grants)" ;
    authz:hasRule ex:rule-admission .

ex:rule-admission a authz:PolicyRule ;
    authz:effect "permit" .

ex:admission-6001 a authz:IngressAdmissionDecision ;
    authz:resolvedRegion core:region-us-west-2 ;
    core:occurredAtTime "2026-08-31T13:06:05Z"^^xsd:dateTime ;
    authz:requestingPrincipal ex:alice ;
    authz:withinSession ex:session-9001 ;
    authz:evaluatedPolicy ex:policy-platform-admission ;
    authz:evaluatedAction authz:action-access ;
    authz:viaChannel core:channel-web ;
    authz:evaluatedGrant ex:grant-t123-channel-web ;
    core:targetsResource ex:app-digital-bank ;
    authz:decidedBy ex:platform-pdp ;
    authz:decisionOutcome authz:outcome-permit .

ex:decision-5001 a authz:PolicyDecision ;
    core:occurredAtTime "2026-08-31T13:06:10Z"^^xsd:dateTime ;
    authz:requestingPrincipal ex:alice ;
    authz:withinSession ex:session-9001 ;
    authz:evaluatedPolicy ex:policy-ledger-read ;
    authz:evaluatedAction authz:action-read ;
    core:targetsResource ex:transaction-service ;
    authz:decidedBy ex:platform-pdp ;
    authz:decisionOutcome authz:outcome-permit .

### Control plane
ex:policy-service a cp:ControlPlaneComponent ;
    core:governedBy ex:policy-ledger-read ;
    core:displayName "Central policy service (PAP)" .

ex:change-7001 a cp:PolicyChangeEvent ;
    core:occurredAtTime "2026-08-30T09:00:00Z"^^xsd:dateTime ;
    cp:executedBy ex:payments-agent ;
    cp:changedPolicy ex:policy-ledger-read ;
    cp:changeTicket "CHG0042117" ;
    cp:hasApproval ex:approval-7001a .

ex:approval-7001a a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-30T08:45:00Z"^^xsd:dateTime .

### Management vs. capability control planes
ex:mgmt-plane a cp:ManagementControlPlane ;
    core:governedBy ex:policy-ledger-read ;
    core:displayName "Platform management control plane" .

ex:tenant-t123 a core:Tenant ;
    core:displayName "Tenant T123" .

ex:cap-notifications a core:Capability ;
    core:displayName "Notifications capability" ;
    cp:isolationModel "cell-per-tenant" .

### Scope tree (single-parent; facets carry dimensions)
ex:scope-root a cp:AdministrativeScope ;
    core:displayName "Platform root scope" .

ex:scope-prod a cp:AdministrativeScope ;
    core:displayName "Production, US" ;
    cp:subScopeOf ex:scope-root ;
    cp:inEnvironment "prod" ;
    cp:inRegion "US" ;
    cp:hasRegion core:region-us-west-2 ;
    cp:requiresHumanApproval true ;
    cp:scopeIncludes ex:t123-notifications-plane , ex:session-store-plane .

### Concurrent session policy — configured per device class
ex:policy-sessions-browser a cp:ConcurrentSessionPolicy ;
    core:displayName "T123: at most 3 concurrent browser sessions" ;
    cp:policyForTenant ex:tenant-t123 ;
    cp:appliesToDeviceClass session:device-browser ;
    cp:maxConcurrentSessions 3 .

ex:policy-sessions-mobile a cp:ConcurrentSessionPolicy ;
    core:displayName "T123: at most 2 concurrent mobile sessions" ;
    cp:policyForTenant ex:tenant-t123 ;
    cp:appliesToDeviceClass session:device-mobile ;
    cp:maxConcurrentSessions 2 .

### Tenant membership — which principals may act for T123
ex:membership-alice-t123 a cp:TenantMembership ;
    core:displayName "Alice Chen acts for Tenant T123" ;
    cp:memberPrincipal ex:alice ;
    cp:memberOfTenant ex:tenant-t123 ;
    cp:memberCapacity "employee" ;
    cp:hasMembershipState cp:memberstate-active ;
    core:validFrom "2026-02-01T00:00:00Z"^^xsd:dateTime ;
    cp:hasApproval ex:approval-mem-1 .

ex:approval-mem-1 a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-01-30T09:00:00Z"^^xsd:dateTime .

### Subscription and offering
ex:sub-9001 a cp:Subscription ;
    core:displayName "T123 subscription: notifications" ;
    cp:subscriber ex:tenant-t123 ;
    cp:subscribedCapability ex:cap-notifications ;
    cp:hasSubscriptionState cp:substate-active ;
    core:validFrom "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    core:validUntil "2027-05-31T23:59:59Z"^^xsd:dateTime ;
    cp:hasApproval ex:approval-9001 .

ex:approval-9001 a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-05-28T10:00:00Z"^^xsd:dateTime .

ex:offering-notifications-prod a cp:CapabilityOffering ;
    core:displayName "Notifications capability offered in production, US" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-offering-1 ;
    cp:hasOfferingState cp:offering-available ;
    cp:offersCapability ex:cap-notifications ;
    cp:offeredInScope ex:scope-prod .
ex:approval-offering-1 a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-10T10:00:00Z"^^xsd:dateTime .

### Application, confirmed requirement, enablement, portal
ex:app-digital-bank a core:Application ;
    core:displayName "T123 digital bank" ;
    core:ownedBy ex:tenant-t123 ;
    core:governedBy ex:policy-ledger-read .

ex:req-digital-bank-notifications a cp:CapabilityRequirement ;
    cp:ofApplication ex:app-digital-bank ;
    cp:requiredCapability ex:cap-notifications ;
    cmt:hasNeed ex:need-digital-bank-availability , ex:need-digital-bank-latency ;
    cp:hasApproval ex:approval-req-1 .
# What the digital bank needs from notifications (D75): approved with the requirement, met by the production offering.
ex:need-digital-bank-availability a cmt:CommitmentNeed ;
    core:displayName "Digital bank needs notifications available at least 99.9 %" ;
    cmt:metric cmt:metric-availability ; cmt:comparator cmt:at-least ; cmt:target 99.9 ; cmt:unit unit:PERCENT .
ex:need-digital-bank-latency a cmt:CommitmentNeed ;
    core:displayName "Digital bank needs notifications latency p99 at most 300 ms" ;
    cmt:metric cmt:metric-latency-p99 ; cmt:comparator cmt:at-most ; cmt:target 300.0 ; cmt:unit unit:MilliSEC .

ex:approval-req-1 a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-20T09:00:00Z"^^xsd:dateTime .

ex:obs-digital-bank-notifications a cp:CapabilityUseObservation ;
    core:occurredAtTime "2026-08-25T00:00:00Z"^^xsd:dateTime ;
    cp:observedApplication ex:app-digital-bank ;
    cp:observedCapability ex:cap-notifications ;
    cp:windowStart "2026-08-18T00:00:00Z"^^xsd:dateTime ;
    cp:windowEnd "2026-08-25T00:00:00Z"^^xsd:dateTime ;
    cp:requestCount 48211 .

ex:enable-8002 a cp:ApplicationEnablement ;
    core:displayName "Enable digital bank for T123 in prod" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:forApplication ex:app-digital-bank ;
    cp:hasApproval ex:approval-8002 .

ex:approval-8002 a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-21T11:00:00Z"^^xsd:dateTime .

ex:portal-t123-web a cp:Portal ;
    core:displayName "T123 web portal" ;
    core:ownedBy ex:tenant-t123 ;
    cp:groupsApplication ex:app-digital-bank .

### Entitlement grant (projection, never hand-authored)
ex:grant-t123-channel-web a authz:EntitlementGrant ;
    authz:grantedTo ex:tenant-t123 ;
    authz:onDimension authz:dim-channel ;
    authz:entitlementValue "web" ;
    authz:derivedFrom ex:route-binding-8003 ;
    authz:distributedAt "2026-08-30T06:00:00Z"^^xsd:dateTime .

ex:notifications-controller-agent a core:WorkloadPrincipal ;
    core:identifier "spiffe://examplebank.com/ns/notifications/sa/controller" ;
    core:displayName "Notifications capability controller" .

ex:notifications-control-plane a cp:CapabilityControlPlane ;
    core:governedBy ex:policy-ledger-read ;
    core:displayName "Notifications capability control plane" ;
    cp:governsCapability ex:cap-notifications ;
    core:hasActingIdentity ex:notifications-controller-agent ;
    cp:actuates ex:t123-notifications-plane .

ex:t123-notifications-plane a cp:DataPlane ;
    core:operatedBy ex:examplebank ;
    cp:holdsDataCategory core:data-customer-personal , core:data-tenant-workload ;
    core:governedBy ex:policy-ledger-read ;
    core:displayName "Tenant T123 notifications data plane" ;
    cp:realizesCapability ex:cap-notifications ;
    cp:servesTenant ex:tenant-t123 .

ex:decl-8001 a cp:DesiredStateDeclaration ;
    core:displayName "T123 notifications: provision prod instance" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:declaresStateOf ex:t123-notifications-plane ;
    cp:justifiedBy ex:sub-9001 ;
    cp:forApplication ex:app-digital-bank ;
    cp:hasApproval ex:approval-8001 .

ex:approval-8001 a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-29T15:00:00Z"^^xsd:dateTime .

ex:mutation-8101 a cp:DataPlaneMutation ;
    core:occurredAtTime "2026-08-31T14:10:00Z"^^xsd:dateTime ;
    cp:executedBy ex:notifications-controller-agent ;
    cp:mutatedDataPlane ex:t123-notifications-plane ;
    cp:realizesIntent ex:decl-8001 .

### Commitment module — a measured guarantee on the notifications offering
ex:source-notifications-metrics a cmt:MeasurementSource ;
    core:displayName "Notifications platform metrics feed" .

ex:commit-notifications-availability a cmt:Commitment ;
    core:displayName "Notifications: availability at least 99.95 %" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-commit-1 ;
    cmt:commitsTo ex:offering-notifications-prod ;
    cmt:rationale "D69: meets the production floor with headroom. An illustrative seed target for a tenant-facing offering, not a platform target." ;
    cmt:metric cmt:metric-availability ;
    cmt:target 99.95 ;
    cmt:unit unit:PERCENT ;
    cmt:comparator cmt:at-least ;
    cmt:window "P30D"^^xsd:duration ;
    cmt:measuredBy ex:source-notifications-metrics ;
    cmt:validatedBy "queries/competency/cq9-commitments-and-evidence.rq"^^xsd:anyURI ;
    cmt:satisfiesBaseline ex:floor-prod-availability ;
    cmt:hasCommitmentState cmt:state-committed .

ex:obs-notifications-availability-2026-08 a cmt:Observation ;
    cmt:observationOf ex:commit-notifications-availability ;
    sosa:observedProperty cmt:metric-availability ;
    sosa:hasSimpleResult 99.97 ;
    cp:windowStart "2026-08-01T00:00:00Z"^^xsd:dateTime ;
    cp:windowEnd "2026-08-31T23:59:59Z"^^xsd:dateTime .

### Region-bound tenant — a region.access grant for exactly one region (CQ-10)
ex:grant-t123-region-us a authz:EntitlementGrant ;
    authz:grantedTo ex:tenant-t123 ;
    authz:onDimension authz:dim-region ;
    authz:entitlementValue "US" ;
    authz:derivedFrom ex:route-binding-8003 ;
    authz:distributedAt "2026-08-30T06:00:00Z"^^xsd:dateTime .

ex:approval-commit-1 a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-09-01T10:00:00Z"^^xsd:dateTime .

### The platform is a distinguished tenant (D10); its staff hold memberships in it,
### so their approvals of platform-level changes come from the authorizing party (D61)
ex:platform-tenant a core:PlatformTenant ;
    core:displayName "The platform" .
ex:membership-alice-platform a cp:TenantMembership ;
    cp:memberPrincipal ex:alice ;
    cp:memberOfTenant ex:platform-tenant ;
    cp:hasMembershipState cp:memberstate-active ;
    cp:hasApproval ex:approval-plat-alice .
ex:approval-plat-alice a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-08-01T09:00:00Z"^^xsd:dateTime .
ex:membership-dana-platform a cp:TenantMembership ;
    cp:memberPrincipal ex:dana ;
    cp:memberOfTenant ex:platform-tenant ;
    cp:hasMembershipState cp:memberstate-active ;
    cp:hasApproval ex:approval-plat-dana .
ex:approval-plat-dana a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-01T09:05:00Z"^^xsd:dateTime .

### Contract module — the notifications capability's published contract (D62)
ex:contract-notifications a ctr:Contract ;
    core:displayName "Notifications capability contract" ;
    ctr:contractOf ex:cap-notifications .
ex:contract-notifications-v1 a ctr:ContractVersion ;
    ctr:versionOf ex:contract-notifications ;
    ctr:versionString "1.2.0" ;
    ctr:hasVersionState ctr:state-published ;
    ctr:compatibility ctr:compatible ;
    ctr:artifact "https://contracts.example/platform/notifications/1.2.0/openapi.yaml"^^xsd:anyURI .
ex:contract-change-1 a ctr:ContractChange ;
    core:displayName "Publish notifications contract 1.2.0" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-contract-1 ;
    ctr:publishesVersion ex:contract-notifications-v1 .
ex:approval-contract-1 a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-15T10:00:00Z"^^xsd:dateTime .
ex:req-digital-bank-notifications ctr:dependsOnContractVersion ex:contract-notifications-v1 .

### Jurisdiction (D64): the platform's operating entity, T123's residency, and a permitted transfer
ex:examplebank a core:LegalEntity ;
    core:displayName "Example Bank AG (platform operator)" ;
    core:underJurisdiction core:jurisdiction-us .
ex:residency-t123-personal a cp:ResidencyRequirement ;
    core:displayName "T123 customer personal data stays in the United States" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-residency-1 ;
    cp:forTenant ex:tenant-t123 ;
    cp:forDataCategory core:data-customer-personal ;
    cp:requiredIn core:jurisdiction-us .
ex:approval-residency-1 a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-08-20T10:00:00Z"^^xsd:dateTime .
ex:transfer-t123-eu a cp:TransferPermission ;
    core:displayName "T123 customer personal data may cross into the EU under contractual clauses"@en ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-transfer-1 ;
    cp:forTenant ex:tenant-t123 ;
    cp:forDataCategory core:data-customer-personal ;
    cp:toJurisdiction core:jurisdiction-eu ;
    cp:transferBasis cp:basis-contractual-clauses .
ex:approval-transfer-1 a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-08-21T10:00:00Z"^^xsd:dateTime .

### Baseline (D66): the production availability floor every production offering must meet
ex:floor-prod-availability a cmt:CommitmentBaseline ;
    core:displayName "Production floor: availability at least 99.9 % over 30 days" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-floor-1 ;
    cmt:rationale "D69: the internal platform standard. About 43 minutes of downtime a month, loose enough that every shared capability can meet it; anything tighter is a promise an individual offering makes on top." ;
    cmt:metric cmt:metric-availability ;
    cmt:comparator cmt:at-least ;
    cmt:target 99.9 ;
    cmt:unit unit:PERCENT ;
    cmt:window "P30D"^^xsd:duration ;
    cmt:referenceSource "https://standards.example/platform/production-floors/2026#availability"^^xsd:anyURI .
ex:approval-floor-1 a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-08-05T10:00:00Z"^^xsd:dateTime .

### The request path is offered (D68): ingress, decision and session capabilities, platform-owned, planned until their commitments exist

ex:cap-ingress a core:Capability ;
    core:displayName "Ingress capability" ;
    cp:isolationModel "shared" .
ex:ingress-controller a core:WorkloadPrincipal ;
    core:identifier "spiffe://examplebank/platform/ingress-controller" ;
    core:displayName "Ingress capability controller" .
ex:ingress-control-plane a cp:CapabilityControlPlane ;
    core:governedBy ex:policy-ledger-read ;
    core:displayName "Ingress capability control plane" ;
    cp:governsCapability ex:cap-ingress ;
    core:hasActingIdentity ex:ingress-controller .
ex:offering-cap-ingress-prod a cp:CapabilityOffering ;
    core:displayName "Ingress capability offered in production" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-offering-cap-ingress ;
    cp:hasOfferingState cp:offering-available ;
    cp:offersCapability ex:cap-ingress ;
    cp:offeredInScope ex:scope-prod .
ex:approval-offering-cap-ingress a cp:ChangeApproval ;
    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-09-01T09:00:00Z"^^xsd:dateTime .
ex:sub-platform-cap-ingress a cp:Subscription ;
    core:displayName "The platform subscribes to its own ingress capability (D10)" ;
    cp:subscriber ex:platform-tenant ;
    cp:subscribedCapability ex:cap-ingress ;
    cp:hasSubscriptionState cp:substate-active ;
    core:validFrom "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    cp:hasApproval ex:approval-sub-cap-ingress .
ex:approval-sub-cap-ingress a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-09-01T09:10:00Z"^^xsd:dateTime .

ex:cap-decision a core:Capability ;
    core:displayName "Authorization decision capability" ;
    cp:isolationModel "shared" .
ex:decision-controller a core:WorkloadPrincipal ;
    core:identifier "spiffe://examplebank/platform/decision-controller" ;
    core:displayName "Authorization decision capability controller" .
