### Production floors (D69): latency p99, recovery time, recovery point — availability above

ex:floor-prod-latency a cmt:CommitmentBaseline ;
    core:displayName "Production floor: latency p99 at most 300 ms over 7 days" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-floor-prod-latency ;
    cmt:rationale "D69: a budget consumers can reserve against. The three request-path capabilities together promise 105 ms, leaving roughly two thirds of the budget to applications." ;
    cmt:metric cmt:metric-latency-p99 ;
    cmt:comparator cmt:at-most ;
    cmt:target 300.0 ;
    cmt:unit unit:MilliSEC ;
    cmt:window "P7D"^^xsd:duration ;
    cmt:referenceSource "https://standards.example/platform/production-floors/2026#latency"^^xsd:anyURI .
ex:approval-floor-prod-latency a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-09-03T10:00:00Z"^^xsd:dateTime .
ex:floor-prod-rto a cmt:CommitmentBaseline ;
    core:displayName "Production floor: recovery time at most 60 minutes, judged per quarter" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-floor-prod-rto ;
    cmt:rationale "D69: a standby target in another region taken into service by a routing change. Tighter than this needs active-active deployment, a design decision not yet taken." ;
    cmt:metric cmt:metric-recovery-time ;
    cmt:comparator cmt:at-most ;
    cmt:target 60.0 ;
    cmt:unit unit:MIN ;
    cmt:window "P90D"^^xsd:duration ;
    cmt:referenceSource "https://standards.example/platform/production-floors/2026#rto"^^xsd:anyURI .
ex:approval-floor-prod-rto a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-09-03T10:00:00Z"^^xsd:dateTime .
ex:floor-prod-rpo a cmt:CommitmentBaseline ;
    core:displayName "Production floor: recovery point at most 15 minutes, judged per quarter" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-floor-prod-rpo ;
    cmt:rationale "D69: asynchronous cross-region replication at a short interval. Stateless capabilities promise zero on top of it." ;
    cmt:metric cmt:metric-recovery-point ;
    cmt:comparator cmt:at-most ;
    cmt:target 15.0 ;
    cmt:unit unit:MIN ;
    cmt:window "P90D"^^xsd:duration ;
    cmt:referenceSource "https://standards.example/platform/production-floors/2026#rpo"^^xsd:anyURI .
ex:approval-floor-prod-rpo a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-09-03T10:00:00Z"^^xsd:dateTime .

