    cp:approvedBy ex:alice ;
    cp:approvedAtTime "2026-09-01T09:00:00Z"^^xsd:dateTime .
ex:sub-platform-cap-decision a cp:Subscription ;
    core:displayName "The platform subscribes to its own authorization decision capability (D10)" ;
    cp:subscriber ex:platform-tenant ;
    cp:subscribedCapability ex:cap-decision ;
    cp:hasSubscriptionState cp:substate-active ;
    core:validFrom "2026-09-01T00:00:00Z"^^xsd:dateTime ;
    cp:hasApproval ex:approval-sub-cap-decision .
ex:approval-sub-cap-decision a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-09-01T09:10:00Z"^^xsd:dateTime .

ex:cap-session a core:Capability ;
    core:displayName "Session management capability" ;
    cp:isolationModel "shared" .
ex:session-controller a core:WorkloadPrincipal ;
    core:identifier "spiffe://examplebank/platform/session-controller" ;
