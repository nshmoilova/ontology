### The request-path targets set by the platform (D71): the six targets that differ from the D70 placeholders, declared as the current promises
ex:commit-cap-ingress-latency a cmt:Commitment ;
    core:displayName "Ingress: latency p99 at most 50.0 ms" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-commit-cap-ingress-latency ;
    cmt:commitsTo ex:offering-cap-ingress-prod ;
    cmt:rationale "D71: covers TLS termination, tenant resolution and the decision call; 50 ms of the 300 ms floor." ;
    cmt:metric cmt:metric-latency-p99 ;
    cmt:comparator cmt:at-most ;
    cmt:target 50.0 ;
    cmt:unit unit:MilliSEC ;
    cmt:window "P7D"^^xsd:duration ;
    cmt:measuredBy ex:source-platform-metrics ;
    cmt:validatedBy "queries/competency/cq16-commitment-status.rq"^^xsd:anyURI ;
    cmt:satisfiesBaseline ex:floor-prod-latency ;
    cmt:hasCommitmentState cmt:state-committed .
ex:approval-commit-cap-ingress-latency a cp:ChangeApproval ;
    cp:approvedBy ex:dana ;
    cp:approvedAtTime "2026-09-03T15:00:00Z"^^xsd:dateTime .
ex:commit-cap-ingress-availability a cmt:Commitment ;
    core:displayName "Ingress: availability at least 99.99 %" ;
    cp:declaredThrough ex:mgmt-plane ;
    cp:declarationScope ex:scope-prod ;
    cp:hasApproval ex:approval-commit-cap-ingress-availability ;
    cmt:commitsTo ex:offering-cap-ingress-prod ;
    cmt:rationale "D71: on every request, so its availability caps everyone's; set above the floor so the capabilities behind it have headroom." ;
    cmt:metric cmt:metric-availability ;
    cmt:comparator cmt:at-least ;
    cmt:target 99.99 ;
    cmt:unit unit:PERCENT ;
    cmt:window "P30D"^^xsd:duration ;
