### The request-path offerings are available (D70): one platform metrics feed, a commitment per floor, a published contract each
ex:source-platform-metrics a cmt:MeasurementSource ;
    core:displayName "Platform observability feed" .
ex:contract-cap-ingress a ctr:Contract ;
    core:displayName "Ingress contract" ;
    ctr:contractOf ex:cap-ingress .
ex:contract-cap-ingress-v1 a ctr:ContractVersion ;
    ctr:versionOf ex:contract-cap-ingress ;
    ctr:versionString "1.0.0" ;
    ctr:hasVersionState ctr:state-published ;
    ctr:compatibility ctr:compatible ;
