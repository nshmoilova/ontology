@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix core:    <https://w3id.org/examplebank/platform/core#> .
@prefix authn:   <https://w3id.org/examplebank/platform/authn#> .
@prefix session: <https://w3id.org/examplebank/platform/session#> .
@prefix ss:      <https://w3id.org/examplebank/platform/shapes/session#> .

ss:SessionShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:property [
        sh:path session:establishedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class authn:AuthenticationJourneyExecution ;
        sh:severity sh:Violation ;
        sh:message "Every session must be established by exactly one authentication journey execution (single-step flows are one-event executions)." ;
    ] ;
    sh:property [
        sh:path session:elevatedBy ;
        sh:class authn:AuthenticationJourneyExecution ;
        sh:severity sh:Violation ;
        sh:message "Session elevations must be authentication journey executions." ;
    ] ;
    sh:property [
        sh:path session:boundToPrincipal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class core:Principal ;
        sh:severity sh:Violation ;
        sh:message "Every session must be bound to exactly one principal." ;
    ] ;
    sh:property [
        sh:path session:hasState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class session:SessionState ;
        sh:severity sh:Violation ;
        sh:message "Every session must have exactly one lifecycle state." ;
    ] ;
    sh:property [
        sh:path session:expiresAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Every session must have an expiry." ;
    ] .

# Cross-entity integrity: the session's principal must match the
# principal of its originating authentication event.
ss:SessionPrincipalConsistencyShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Session principal must match the principal of its originating authentication event." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/session#establishedBy> ?x ;
                      <https://w3id.org/examplebank/platform/session#boundToPrincipal> ?p .
                ?x <https://w3id.org/examplebank/platform/authn#authenticatedPrincipal> ?ap .
                FILTER (?p != ?ap)
            }
        """ ;
    ] .

# Cross-entity integrity: an active session may not originate from a
# failed authentication journey execution.
ss:ActiveSessionSuccessfulAuthnShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An active session must originate from a successful authentication journey execution." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/session#hasState>
                      <https://w3id.org/examplebank/platform/session#state-active> ;
                      <https://w3id.org/examplebank/platform/session#establishedBy> ?x .
                ?x <https://w3id.org/examplebank/platform/authn#succeeded> false .
            }
        """ ;
    ] .

ss:DeviceShape a sh:NodeShape ;
    sh:targetClass session:Device ;
    sh:property [
        sh:path core:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A device must carry exactly one identifier — a concurrency limit counts sessions per device, and an unnamed device cannot be counted." ;
    ] ;
    sh:property [
        sh:path session:hasDeviceClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class session:DeviceClass ;
        sh:severity sh:Violation ;
        sh:message "A device must have exactly one device class from the closed vocabulary — concurrency limits are configured against it." ;
    ] .

ss:SessionDeviceShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:property [
        sh:path session:onDevice ;
        sh:maxCount 1 ;
        sh:class session:Device ;
        sh:severity sh:Violation ;
        sh:message "A session runs on at most one device; non-interactive sessions have none." ;
    ] .

# One session per user per device.
ss:OneSessionPerDeviceShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Principal holds more than one active session on the same device — the platform issues one session per user per device." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/session#hasState>
                      <https://w3id.org/examplebank/platform/session#state-active> ;
                      <https://w3id.org/examplebank/platform/session#boundToPrincipal> ?p ;
                      <https://w3id.org/examplebank/platform/session#onDevice> ?d .
                ?other <https://w3id.org/examplebank/platform/session#hasState>
                       <https://w3id.org/examplebank/platform/session#state-active> ;
                       <https://w3id.org/examplebank/platform/session#boundToPrincipal> ?p ;
                       <https://w3id.org/examplebank/platform/session#onDevice> ?d .
                FILTER (?other != $this)
            }
        """ ;
    ] .

# Configured concurrency ceiling, per principal per device class.
ss:ConcurrentSessionLimitShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Principal exceeds the configured concurrent-session limit for this device class." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                {
                    SELECT $this ?p ?dc (COUNT(DISTINCT ?s2) AS ?n) WHERE {
                        $this <https://w3id.org/examplebank/platform/session#hasState>
                              <https://w3id.org/examplebank/platform/session#state-active> ;
                              <https://w3id.org/examplebank/platform/session#boundToPrincipal> ?p ;
                              <https://w3id.org/examplebank/platform/session#onDevice> ?dev .
                        ?dev <https://w3id.org/examplebank/platform/session#hasDeviceClass> ?dc .
                        ?s2 <https://w3id.org/examplebank/platform/session#hasState>
                            <https://w3id.org/examplebank/platform/session#state-active> ;
                            <https://w3id.org/examplebank/platform/session#boundToPrincipal> ?p ;
                            <https://w3id.org/examplebank/platform/session#onDevice> ?d2 .
                        ?d2 <https://w3id.org/examplebank/platform/session#hasDeviceClass> ?dc .
                    } GROUP BY $this ?p ?dc
                }
                ?m <https://w3id.org/examplebank/platform/control-plane#memberPrincipal> ?p ;
                   <https://w3id.org/examplebank/platform/control-plane#memberOfTenant> ?t ;
                   <https://w3id.org/examplebank/platform/control-plane#hasMembershipState>
                   <https://w3id.org/examplebank/platform/control-plane#memberstate-active> .
                ?pol <https://w3id.org/examplebank/platform/control-plane#policyForTenant> ?t ;
                     <https://w3id.org/examplebank/platform/control-plane#appliesToDeviceClass> ?dc ;
                     <https://w3id.org/examplebank/platform/control-plane#maxConcurrentSessions> ?max .
                FILTER (?n > ?max)
            }
        """ ;
    ] .

# The journey definition establishes the channel; where the session also has
# a device, its class must corroborate rather than contradict it.
ss:ChannelDeviceAgreementShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Session's device class implies a different channel than its journey definition establishes." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/session#onDevice> ?dev ;
                      <https://w3id.org/examplebank/platform/session#establishedBy> ?exec .
                ?dev <https://w3id.org/examplebank/platform/session#hasDeviceClass> ?dc .
                ?dc <https://w3id.org/examplebank/platform/session#impliesChannel> ?implied .
                ?exec <https://w3id.org/examplebank/platform/authn#followsDefinition> ?def .
                ?def <https://w3id.org/examplebank/platform/authn#servesChannel> ?served .
                FILTER (?implied != ?served)
            }
        """ ;
    ] .

ss:SessionHandleShape a sh:NodeShape ;
    sh:targetClass session:SessionHandle ;
    sh:property [
        sh:path session:resolvesToSession ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class session:Session ;
        sh:severity sh:Violation ;
        sh:message "A session handle must resolve to exactly one session — an ambiguous handle is a session-fixation hazard." ;
    ] .

# Sender constraining: a session that is not bound to a proof-of-possession
# key is a bearer session — whoever steals the handle can use it.
ss:SenderConstrainedSessionShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:property [
        sh:path authn:confirmedByKey ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class authn:ProofOfPossessionKey ;
        sh:severity sh:Violation ;
        sh:message "Session is not sender-constrained: no proof-of-possession key confirms it, so a stolen handle alone would be replayable." ;
    ] .

# Constraint laundering: a sender-constrained session must not hand out
# tokens that are unbound, or bound to a different key.
ss:TokenInheritsConfirmationShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Session issued a token bound to a different key, or to no key at all — sender constraining must not be lost at token issuance." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/authn#confirmedByKey> ?k ;
                      <https://w3id.org/examplebank/platform/session#issuedToken> ?tok .
                FILTER NOT EXISTS {
                    ?tok <https://w3id.org/examplebank/platform/authn#confirmedByKey> ?k .
                }
            }
        """ ;
    ] .

# One key must not confirm sessions belonging to different principals.
ss:KeyConfusionShape a sh:NodeShape ;
    sh:targetClass session:Session ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One proof-of-possession key confirms sessions bound to different principals — key confusion." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/authn#confirmedByKey> ?k ;
                      <https://w3id.org/examplebank/platform/session#boundToPrincipal> ?p1 .
                ?other <https://w3id.org/examplebank/platform/authn#confirmedByKey> ?k ;
                       <https://w3id.org/examplebank/platform/session#boundToPrincipal> ?p2 .
                FILTER (?other != $this)
                FILTER (?p1 != ?p2)
            }
        """ ;
    ] .

ss:TokenShape a sh:NodeShape ;
    sh:targetClass session:Token ;
    sh:property [
        sh:path session:expiresAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Every token must have an expiry." ;
    ] .
