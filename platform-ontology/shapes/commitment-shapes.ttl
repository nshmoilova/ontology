@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix cp:   <https://w3id.org/examplebank/platform/control-plane#> .
@prefix cmt:  <https://w3id.org/examplebank/platform/commitment#> .
@prefix scm:  <https://w3id.org/examplebank/platform/shapes/commitment#> .

# "Every guarantee is measured": a commitment without a measurement source or a
# validation mechanism is aspirational, not a guarantee (D58).
scm:CommitmentShape a sh:NodeShape ;
    sh:targetClass cmt:Commitment ;
    sh:property [ sh:path cmt:commitsTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cp:CapabilityOffering ; sh:severity sh:Violation ;
        sh:message "A commitment is made for exactly one capability offering." ] ;
    sh:property [ sh:path cmt:metric ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Metric ; sh:severity sh:Violation ;
        sh:message "A commitment targets exactly one metric from the closed scheme." ] ;
    sh:property [ sh:path cmt:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:severity sh:Violation ;
        sh:message "A commitment has exactly one decimal target." ] ;
    sh:property [ sh:path cmt:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:severity sh:Violation ;
        sh:message "A commitment states exactly one unit (a QUDT unit IRI)." ] ;
    sh:property [ sh:path cmt:comparator ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Comparator ; sh:severity sh:Violation ;
        sh:message "A commitment states exactly one comparator." ] ;
    sh:property [ sh:path cmt:window ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:duration ; sh:severity sh:Violation ;
        sh:message "A commitment is judged over exactly one window." ] ;
    sh:property [ sh:path cmt:measuredBy ; sh:minCount 1 ; sh:class cmt:MeasurementSource ; sh:severity sh:Violation ;
        sh:message "Commitment has no measurement source — an unmeasured claim is aspirational, not a guarantee." ] ;
    sh:property [ sh:path cmt:validatedBy ; sh:minCount 1 ; sh:datatype xsd:anyURI ; sh:severity sh:Violation ;
        sh:message "Commitment has no validation mechanism — a claim nothing checks is aspirational, not a guarantee." ] ;
    sh:property [ sh:path cmt:hasCommitmentState ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:CommitmentState ; sh:severity sh:Violation ;
        sh:message "A commitment is in exactly one lifecycle state." ] .

scm:ObservationShape a sh:NodeShape ;
    sh:targetClass cmt:Observation ;
    sh:property [ sh:path cmt:observationOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Commitment ; sh:severity sh:Violation ;
        sh:message "An observation evidences exactly one commitment." ] ;
    sh:property [ sh:path sosa:observedProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Metric ; sh:severity sh:Violation ;
        sh:message "An observation observes exactly one metric." ] ;
    sh:property [ sh:path sosa:hasSimpleResult ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
        sh:message "An observation carries exactly one result." ] ;
    sh:property [ sh:path cp:windowStart ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:severity sh:Violation ;
        sh:message "An observation is a windowed aggregate — it has a window start." ] ;
    sh:property [ sh:path cp:windowEnd ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:severity sh:Violation ;
        sh:message "An observation is a windowed aggregate — it has a window end." ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Observation measures a different metric than the commitment it evidences." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/commitment#observationOf> ?c ; <http://www.w3.org/ns/sosa/observedProperty> ?m .
                ?c <https://w3id.org/examplebank/platform/commitment#metric> ?cm .
                FILTER(?m != ?cm)
            }
        """ ;
    ] .

# D59 — a commitment is a declaration; it is declared at or above the scope of
# the offering it is for, so the declaration's approval rigor covers the promise.
scm:CommitmentScopeShape a sh:NodeShape ;
    sh:targetClass cmt:Commitment ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Commitment is declared in a scope that does not contain its offering's scope — a promise is declared at or above where it applies." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/commitment#commitsTo> ?off ; <https://w3id.org/examplebank/platform/control-plane#declarationScope> ?decl .
                ?off <https://w3id.org/examplebank/platform/control-plane#offeredInScope> ?offScope .
                FILTER NOT EXISTS { ?offScope <https://w3id.org/examplebank/platform/control-plane#subScopeOf>* ?decl . }
            }
        """ ;
    ] .

# D66 — baselines: well-formed floors; no committed commitment weaker than a floor
# that covers its offering; an available offering under a floor carries a commitment on the floor's metric.
scm:CommitmentBaselineShape a sh:NodeShape ;
    sh:targetClass cmt:CommitmentBaseline ;
    sh:property [ sh:path cmt:metric ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Metric ; sh:severity sh:Violation ; sh:message "A baseline targets exactly one metric from the closed scheme." ] ;
    sh:property [ sh:path cmt:comparator ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Comparator ; sh:severity sh:Violation ; sh:message "A baseline states exactly one comparator." ] ;
    sh:property [ sh:path cmt:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:severity sh:Violation ; sh:message "A baseline has exactly one decimal target." ] ;
    sh:property [ sh:path cmt:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:severity sh:Violation ; sh:message "A baseline states exactly one unit." ] ;
    sh:property [ sh:path cmt:window ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:duration ; sh:severity sh:Violation ; sh:message "A baseline is judged over exactly one window." ] .

scm:NoWeakerThanFloorShape a sh:NodeShape ;
    sh:targetClass cmt:Commitment ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Committed commitment is weaker than the floor declared for its offering's scope — a promise below the baseline." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/commitment#commitsTo> ?off ; <https://w3id.org/examplebank/platform/commitment#metric> ?m ; <https://w3id.org/examplebank/platform/commitment#comparator> ?cmp ; <https://w3id.org/examplebank/platform/commitment#target> ?t ;
                      <https://w3id.org/examplebank/platform/commitment#hasCommitmentState> <https://w3id.org/examplebank/platform/commitment#state-committed> .
                ?off <https://w3id.org/examplebank/platform/control-plane#offeredInScope> ?os . ?os <https://w3id.org/examplebank/platform/control-plane#subScopeOf>* ?fs .
                ?fl a <https://w3id.org/examplebank/platform/commitment#CommitmentBaseline> ; <https://w3id.org/examplebank/platform/control-plane#declarationScope> ?fs ; <https://w3id.org/examplebank/platform/commitment#metric> ?m ; <https://w3id.org/examplebank/platform/commitment#comparator> ?cmp ; <https://w3id.org/examplebank/platform/commitment#target> ?ft .
                FILTER( (?cmp = <https://w3id.org/examplebank/platform/commitment#at-least> && ?t < ?ft) || (?cmp = <https://w3id.org/examplebank/platform/commitment#at-most> && ?t > ?ft) )
            }
        """ ;
    ] .

scm:FloorCoverageShape a sh:NodeShape ;
    sh:targetClass cp:CapabilityOffering ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Available offering carries no committed commitment on a metric its scope's floor requires — not ready against the baseline." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/control-plane#hasOfferingState> <https://w3id.org/examplebank/platform/control-plane#offering-available> ; <https://w3id.org/examplebank/platform/control-plane#offeredInScope> ?os .
                ?os <https://w3id.org/examplebank/platform/control-plane#subScopeOf>* ?fs .
                ?fl a <https://w3id.org/examplebank/platform/commitment#CommitmentBaseline> ; <https://w3id.org/examplebank/platform/control-plane#declarationScope> ?fs ; <https://w3id.org/examplebank/platform/commitment#metric> ?m .
                FILTER NOT EXISTS { ?cm <https://w3id.org/examplebank/platform/commitment#commitsTo> $this ; <https://w3id.org/examplebank/platform/commitment#metric> ?m ; <https://w3id.org/examplebank/platform/commitment#hasCommitmentState> <https://w3id.org/examplebank/platform/commitment#state-committed> . }
            }
        """ ;
    ] .

# D69 — a commitment is compared to its floor in the floor's unit; a mismatch is not a comparison.
scm:FloorUnitShape a sh:NodeShape ;
    sh:targetClass cmt:Commitment ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Committed commitment states a different unit than the floor for its offering's scope on the same metric — targets in different units cannot be compared." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/commitment#commitsTo> ?off ; <https://w3id.org/examplebank/platform/commitment#metric> ?m ; <https://w3id.org/examplebank/platform/commitment#unit> ?u ; <https://w3id.org/examplebank/platform/commitment#hasCommitmentState> <https://w3id.org/examplebank/platform/commitment#state-committed> .
                ?off <https://w3id.org/examplebank/platform/control-plane#offeredInScope> ?os . ?os <https://w3id.org/examplebank/platform/control-plane#subScopeOf>* ?fs .
                ?fl a <https://w3id.org/examplebank/platform/commitment#CommitmentBaseline> ; <https://w3id.org/examplebank/platform/control-plane#declarationScope> ?fs ; <https://w3id.org/examplebank/platform/commitment#metric> ?m ; <https://w3id.org/examplebank/platform/commitment#unit> ?fu .
                FILTER(?u != ?fu)
            }
        """ ;
    ] .

# D72 — a number without its reason cannot be reviewed. A committed commitment
# and a floor each record why their target is what it is; a missing reason is a
# stewardship warning, not a violation: the promise still binds and is measured.
scm:CommitmentRationaleShape a sh:NodeShape ;
    sh:targetClass cmt:Commitment ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Committed commitment records no rationale — a target without its reason cannot be reviewed; route to stewardship review." ;
        sh:severity sh:Warning ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/commitment#hasCommitmentState> <https://w3id.org/examplebank/platform/commitment#state-committed> .
                FILTER NOT EXISTS { $this <https://w3id.org/examplebank/platform/commitment#rationale> ?r . }
            }
        """ ;
    ] .

scm:BaselineRationaleShape a sh:NodeShape ;
    sh:targetClass cmt:CommitmentBaseline ;
    sh:property [ sh:path cmt:rationale ; sh:minCount 1 ; sh:datatype xsd:string ; sh:severity sh:Warning ;
        sh:message "Floor records no rationale — a baseline without its reason cannot be reviewed; route to stewardship review." ] .


# D74 — every metric in the scheme states when it applies; the closure is what
# makes "which metrics make sense for this capability" answerable (P7).
scm:MetricApplicabilityShape a sh:NodeShape ;
    sh:targetClass cmt:Metric ;
    sh:property [ sh:path cmt:appliesWhen ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Applicability ; sh:severity sh:Violation ;
        sh:message "A metric states exactly one applicability condition from the closed scheme — a metric with none cannot be offered to a capability owner as advice." ] .

# D75 — a need is well-formed and belongs to a requirement; an enabled
# application's needs are met by every available offering covering its scope.
scm:CommitmentNeedShape a sh:NodeShape ;
    sh:targetClass cmt:CommitmentNeed ;
    sh:property [ sh:path cmt:metric ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Metric ; sh:severity sh:Violation ;
        sh:message "A need targets exactly one metric from the closed scheme." ] ;
    sh:property [ sh:path cmt:comparator ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cmt:Comparator ; sh:severity sh:Violation ;
        sh:message "A need states exactly one comparator." ] ;
    sh:property [ sh:path cmt:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:severity sh:Violation ;
        sh:message "A need has exactly one decimal target." ] ;
    sh:property [ sh:path cmt:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:severity sh:Violation ;
        sh:message "A need states exactly one unit (a QUDT unit IRI)." ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Need is stated by no capability requirement — a minimum nobody requires is not a need." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { ?r <https://w3id.org/examplebank/platform/commitment#hasNeed> $this . }
            }
        """ ;
    ] .

scm:NeedMetShape a sh:NodeShape ;
    sh:targetClass cp:CapabilityRequirement ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Enabled application requires more than the covering offering promises — a consumer's stated need on a metric is met by no committed promise, in the need's unit, of an available offering covering the enablement's scope." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this ?need ?o WHERE {
                $this <https://w3id.org/examplebank/platform/control-plane#ofApplication> ?app ;
                      <https://w3id.org/examplebank/platform/control-plane#requiredCapability> ?c ;
                      <https://w3id.org/examplebank/platform/commitment#hasNeed> ?need .
                ?need <https://w3id.org/examplebank/platform/commitment#metric> ?m ;
                      <https://w3id.org/examplebank/platform/commitment#comparator> ?cmp ;
                      <https://w3id.org/examplebank/platform/commitment#target> ?t ;
                      <https://w3id.org/examplebank/platform/commitment#unit> ?u .
                ?e a <https://w3id.org/examplebank/platform/control-plane#ApplicationEnablement> ;
                   <https://w3id.org/examplebank/platform/control-plane#forApplication> ?app ;
                   <https://w3id.org/examplebank/platform/control-plane#declarationScope> ?s .
                ?o <https://w3id.org/examplebank/platform/control-plane#offersCapability> ?c ;
                   <https://w3id.org/examplebank/platform/control-plane#offeredInScope> ?os ;
                   <https://w3id.org/examplebank/platform/control-plane#hasOfferingState> <https://w3id.org/examplebank/platform/control-plane#offering-available> .
                ?s <https://w3id.org/examplebank/platform/control-plane#subScopeOf>* ?os .
                FILTER NOT EXISTS {
                    ?cm <https://w3id.org/examplebank/platform/commitment#commitsTo> ?o ;
                        <https://w3id.org/examplebank/platform/commitment#metric> ?m ;
                        <https://w3id.org/examplebank/platform/commitment#unit> ?u ;
                        <https://w3id.org/examplebank/platform/commitment#comparator> ?cmp ;
                        <https://w3id.org/examplebank/platform/commitment#target> ?ct ;
                        <https://w3id.org/examplebank/platform/commitment#hasCommitmentState> <https://w3id.org/examplebank/platform/commitment#state-committed> .
                    FILTER( (?cmp = <https://w3id.org/examplebank/platform/commitment#at-least> && ?ct >= ?t)
                         || (?cmp = <https://w3id.org/examplebank/platform/commitment#at-most> && ?ct <= ?t) )
                }
            }
        """ ;
    ] .
