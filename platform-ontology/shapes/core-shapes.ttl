@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <https://w3id.org/examplebank/platform/core#> .
@prefix sc:   <https://w3id.org/examplebank/platform/shapes/core#> .

sc:PrincipalShape a sh:NodeShape ;
    sh:targetClass core:Principal ;
    sh:property [
        sh:path core:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Every principal must carry exactly one canonical firm-wide identifier." ;
    ] .

sc:PlatformEventShape a sh:NodeShape ;
    sh:targetClass core:PlatformEvent ;
    sh:property [
        sh:path core:occurredAtTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Every platform event must have exactly one occurrence timestamp." ;
    ] ;
    sh:property [
        sh:path core:performedBy ;
        sh:class core:Principal ;
        sh:severity sh:Violation ;
        sh:message "performedBy must reference a Principal." ;
    ] .

sc:ApplicationShape a sh:NodeShape ;
    sh:targetClass core:Application ;
    sh:property [
        sh:path core:ownedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class core:Tenant ;
        sh:severity sh:Violation ;
        sh:message "An application must be owned by exactly one tenant (the platform tenant for platform-owned applications)." ;
    ] .

sc:BusinessClientShape a sh:NodeShape ;
    sh:targetClass core:BusinessClient ;
    sh:property [
        sh:path core:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A business client must carry exactly one canonical customer identifier." ;
    ] .

# A client relationship nobody can exercise is worth reviewing, not rejecting.
sc:UnreachableClientShape a sh:NodeShape ;
    sh:targetClass core:BusinessClient ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Business client has no principal acting for it — a relationship nobody can exercise; route to stewardship review." ;
        sh:severity sh:Warning ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    ?p <https://w3id.org/examplebank/platform/core#actsForClient> $this .
                }
            }
        """ ;
    ] .

sc:ResourceGovernanceShape a sh:NodeShape ;
    sh:targetClass core:Resource ;
    sh:property [
        sh:path core:governedBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Resource has no governing policy — flag for stewardship review." ;
    ] .

# P13 — decisions are policy-based and externalized. The enforcement point that
# acts on a decision is a different component from the one that rendered it.
sc:DecisionEnforcementSeparationShape a sh:NodeShape ;
    sh:targetClass core:PolicyDecisionPoint ;
    sh:not [ sh:class core:PolicyEnforcementPoint ] ;
    sh:severity sh:Violation ;
    sh:message "A policy decision point must not also be a policy enforcement point — the decision is rendered by one component and acted on by another." .

