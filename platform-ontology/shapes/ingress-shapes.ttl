@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix core:    <https://w3id.org/examplebank/platform/core#> .
@prefix ingress: <https://w3id.org/examplebank/platform/ingress#> .
@prefix si:      <https://w3id.org/examplebank/platform/shapes/ingress#> .

si:GatewayShape a sh:NodeShape ;
    sh:targetClass ingress:Gateway ;
    sh:property [
        sh:path ingress:hasListener ;
        sh:minCount 1 ;
        sh:class ingress:Listener ;
        sh:severity sh:Violation ;
        sh:message "A gateway must expose at least one listener." ;
    ] .

si:ListenerShape a sh:NodeShape ;
    sh:targetClass ingress:Listener ;
    sh:property [
        sh:path ingress:port ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 65535 ;
        sh:severity sh:Violation ;
        sh:message "A listener must have exactly one valid port." ;
    ] ;
    sh:property [
        sh:path ingress:protocol ;
        sh:minCount 1 ;
        sh:in ( "HTTPS" "TLS" "TCP" "HTTP" ) ;
        sh:severity sh:Violation ;
        sh:message "Listener protocol must be one of HTTPS, TLS, TCP, HTTP." ;
    ] .

# Plaintext HTTP listeners are flagged for review, not rejected outright.
si:PlaintextListenerWarningShape a sh:NodeShape ;
    sh:targetClass ingress:Listener ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Listener uses plaintext HTTP — confirm this is an internal redirect-only listener." ;
        sh:severity sh:Warning ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/ingress#protocol> "HTTP" .
            }
        """ ;
    ] .

# A route that resolves tenant context must carry the address it resolves
# from — a tenant binding with no hostname is unresolvable configuration.
si:TenantBoundRouteShape a sh:NodeShape ;
    sh:targetClass ingress:Route ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Route binds a tenant but declares no hostname — tenant context cannot be resolved from an address that is not stated." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/ingress#boundToTenant> ?t .
                FILTER NOT EXISTS {
                    $this <https://w3id.org/examplebank/platform/ingress#hostname> ?h .
                }
            }
        """ ;
    ] .

# Two tenants reachable at one address is a tenant-resolution breach.
si:RouteBindingCollisionShape a sh:NodeShape ;
    sh:targetClass ingress:Route ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Two routes bind the same domain and path to different tenants — one address must resolve to exactly one tenant." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/ingress#hostname> ?h ;
                      <https://w3id.org/examplebank/platform/ingress#boundToTenant> ?t1 .
                ?other <https://w3id.org/examplebank/platform/ingress#hostname> ?h ;
                       <https://w3id.org/examplebank/platform/ingress#boundToTenant> ?t2 .
                FILTER (?other != $this)
                FILTER (?t1 != ?t2)
                OPTIONAL { $this <https://w3id.org/examplebank/platform/ingress#pathPrefix> ?p1 . }
                OPTIONAL { ?other <https://w3id.org/examplebank/platform/ingress#pathPrefix> ?p2 . }
                FILTER (COALESCE(?p1, "/") = COALESCE(?p2, "/"))
            }
        """ ;
    ] .

# Route bindings are governed desired state, not loose configuration.
si:GovernedRouteBindingShape a sh:NodeShape ;
    sh:targetClass ingress:Route ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Route binds a tenant with no route-binding declaration behind it — tenant resolution must be governed, not configured out of band." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://w3id.org/examplebank/platform/ingress#boundToTenant> ?t .
                FILTER NOT EXISTS {
                    ?d a <https://w3id.org/examplebank/platform/control-plane#RouteBindingChange> ;
                       <https://w3id.org/examplebank/platform/control-plane#declaresRouteBinding> $this .
                }
            }
        """ ;
    ] .

si:RouteShape a sh:NodeShape ;
    sh:targetClass ingress:Route ;
    sh:property [
        sh:path ingress:routesTo ;
        sh:minCount 1 ;
        sh:class ingress:UpstreamService ;
        sh:severity sh:Violation ;
        sh:message "A route must forward to at least one upstream service." ;
    ] ;
    sh:property [
        sh:path core:enforcedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class core:PolicyEnforcementPoint ;
        sh:severity sh:Violation ;
        sh:message "Every route must be mediated by exactly one policy enforcement point before its upstream." ;
    ] ;
    sh:property [
        sh:path ingress:boundToTenant ;
        sh:maxCount 1 ;
        sh:class core:Tenant ;
        sh:severity sh:Violation ;
        sh:message "A route binds at most one tenant, and what it binds must be a tenant — a domain resolves to a tenant, it does not substitute for one." ;
    ] .
